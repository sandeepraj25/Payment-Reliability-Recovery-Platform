# Copy to .env and change every value. .env is git-ignored. NEVER commit real secrets.
PAYGUARD_DB_URL=jdbc:postgresql://localhost:5432/payguard
PAYGUARD_DB_USER=payguard
PAYGUARD_DB_PASSWORD=change-me-db-password

PAYGUARD_ADMIN_USER=admin
PAYGUARD_ADMIN_PASSWORD=change-me-admin-password

PAYGUARD_GATEWAY_CLIENT_ID=merchant_client
PAYGUARD_GATEWAY_CLIENT_SECRET=change-me-gateway-secret

# Shared HMAC secret between the simulated gateway and the merchant webhook endpoint (>= 16 chars).
PAYGUARD_WEBHOOK_SECRET=change-me-webhook-hmac-secret

# Local/demo only. Keep false anywhere real.
PAYGUARD_SIMULATOR_ENABLED=true

PAYGUARD_RABBIT_USER=payguard
PAYGUARD_RABBIT_PASSWORD=change-me-rabbit-password

# Local/demo only: enables the Failure Simulation Lab. Keep false anywhere real.
PAYGUARD_FAULTS_ENABLED=true

# Optional read-only dashboard user (leave empty to disable).
PAYGUARD_VIEWER_USER=viewer
PAYGUARD_VIEWER_PASSWORD=
# Browser origins allowed to call the API directly (only needed for `npm run dev` without the proxy).
PAYGUARD_CORS_ORIGINS=http://localhost:5173
